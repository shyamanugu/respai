# ============================================================================
#  AFNI LLMOps + APIX — consolidated configuration
#  Copy to `.env`, fill in the values, and every service (ai_pipeline job,
#  chatbot, dashboard api/web, ops-console) reads from it. In Azure Container
#  Apps, paste these as environment variables / Key Vault secret refs.
#
#  Tags:  [REQUIRED] must be set   [OPTIONAL] has a safe default
#         [MUST MATCH] identical value required across the services noted
# ============================================================================

# ── Environment / platform knobs ────────────────────────────────────────────
APIX_ENV=dev                              # [REQUIRED] dev|test|prod (drives model resolve, guardrails, gate thresholds)
LLMOPS_PLATFORM_ROOT=/app/platform        # [OPTIONAL] where platform/bootstrap.py lives (containers set this; local auto-detects)
LLMOPS_TRACER=jsonl                       # [OPTIONAL] jsonl|memory|null|azure  (jsonl = local sink the ops-console reads)
LLMOPS_TRACE_FILE=/data/traces/trace.jsonl        # [OPTIONAL][MUST MATCH all apps + ops-console] shared trace sink
APIX_FEEDBACK_PATH=/data/feedback/feedback.jsonl  # [OPTIONAL][MUST MATCH apps + ops-console] shared feedback sink
APIX_EVAL_HISTORY_PATH=/data/eval/eval_runs.jsonl # [OPTIONAL][MUST MATCH] eval-gate run history the ops-console reads
OPS_DB_PATH=/data/ops/ops.db              # [OPTIONAL] ops-console SQLite mirror (rebuilt from the JSONL sinks)
OPS_CORS_ORIGINS=*                        # [OPTIONAL] comma-separated allowed origins for the ops-console API

# ── Azure OpenAI (reasoning model) — shared by all three APIX apps ───────────
REASONING_MODEL_ENDPOINT=                 # [REQUIRED][MUST MATCH pipeline+app+chatbot] e.g. https://<resource>.openai.azure.com
REASONING_MODEL_APIKEY=                   # [REQUIRED][MUST MATCH]  (Key Vault secret in prod)
REASONING_MODEL_DEPLOYMENT=               # [REQUIRED][MUST MATCH]  e.g. gpt-5.4-nano  (fallback when model aliases are null)
REASONING_MODEL_BASE_URL=                 # [OPTIONAL] override; else derived as <endpoint-host>/openai/v1/
REASONING_MODEL_MAX_TOKENS=0              # [OPTIONAL] 0 = don't cap on first attempt (pipeline)

# Platform model-management provider (only if you provision the `reason`/`bulk`
# aliases in platform/services/03-model-management/config/models.yaml; otherwise
# the adapters fail open to REASONING_MODEL_* above).
AZURE_OPENAI_ENDPOINT=                    # [OPTIONAL] platform AzureOpenAIProvider / eval LLM-judge
AZURE_OPENAI_API_KEY=                     # [OPTIONAL]

# ── Azure Blob / ADLS — the weekly data contract (pipeline writes, app+chatbot read) ─
AZURE_BLOB_CONNECTION_STRING=             # [REQUIRED for app+chatbot][MUST MATCH] weekly per-employee JSON store + sessions
AZURE_BLOB_CONTAINER=                     # [REQUIRED for app+chatbot][MUST MATCH]
INDEX_BLOB_PATH=                          # [OPTIONAL] app: path to the week index blob
REPORTS_PREFIX=                           # [OPTIONAL] app: prefix for weekly report blobs
# Pipeline storage (ai_pipeline writes raw/denoised/analysis/summary parquet + CSV):
SALES_STORAGE_ACCOUNT_NAME=               # [REQUIRED for pipeline]
SALES_STORAGE_ACCOUNT_KEY=                # [REQUIRED for pipeline]  (Key Vault secret in prod)
SALES_RAW_CONTAINER=raw                   # [OPTIONAL]
SALES_DENOISED_CONTAINER=denoised-transcripts   # [OPTIONAL]
SALES_ANALYSIS_CONTAINER=analysis         # [OPTIONAL]
SALES_SUMMARY_CONTAINER=summary           # [OPTIONAL]  (per-employee weekly JSON — the contract the app reads)
SALES_COACH_HIERARCHY_CONTAINER=coach-hierarchy  # [OPTIONAL]

# ── Azure SQL (vzw.rep_pivoted) — pipeline + app + chatbot ───────────────────
# The three apps use different prefixes for the SAME database — keep them consistent.
APP_AZURE_SQL_SERVER=                     # [REQUIRED for app][MUST MATCH the pipeline/chatbot server]
APP_AZURE_SQL_DATABASE=                   # [REQUIRED for app][MUST MATCH]
APP_AZURE_SQL_PORT=1433                   # [OPTIONAL]
APP_AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server   # [REQUIRED]
APP_AZURE_SQL_LOGIN_TIMEOUT=30            # [OPTIONAL]
APP_AZURE_SQL_QUERY_TIMEOUT=60            # [OPTIONAL]
# Pipeline reads AI_PIPELINE_AZURE_SQL_* and falls back to APP_AZURE_SQL_* — set these only to override:
AI_PIPELINE_AZURE_SQL_SERVER=             # [OPTIONAL] defaults to APP_AZURE_SQL_SERVER
AI_PIPELINE_AZURE_SQL_DATABASE=           # [OPTIONAL] defaults to APP_AZURE_SQL_DATABASE
# Chatbot SQL (same DB; DefaultAzureCredential / AAD token):
AZURE_SQL_SERVER=                         # [REQUIRED for chatbot][MUST MATCH]
AZURE_SQL_DATABASE=                       # [REQUIRED for chatbot][MUST MATCH]
AZURE_SQL_PORT=1433                       # [OPTIONAL]
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server   # [REQUIRED for chatbot]
REP_TABLE=vzw.rep_pivoted                 # [OPTIONAL]
SOURCE_MODE=auto                          # [OPTIONAL] auto|sqlite|azure|both

# ── Microsoft Entra SSO (dashboard api) ──────────────────────────────────────
ENTRA_TENANT_ID=                          # [REQUIRED for dashboard SSO]
ENTRA_CLIENT_ID=                          # [REQUIRED for dashboard SSO]
ENTRA_CLIENT_SECRET=                      # [REQUIRED for dashboard SSO]  (Key Vault secret)
ENTRA_REDIRECT_URI=                       # [REQUIRED for dashboard SSO]  e.g. https://<api-host>/api/auth/callback
APIX_SESSION_SECRET=                      # [REQUIRED for dashboard] signs the HttpOnly session cookie (Key Vault secret)

# ── Chatbot auth (shared HMAC JWT between dashboard and chatbot) ──────────────
CHAT_JWT_SECRET=                          # [REQUIRED][MUST MATCH dashboard api + chatbot]  (Key Vault secret)
CHAT_JWT_ALG=HS256                        # [OPTIONAL][MUST MATCH]
CHAT_JWT_ISSUER=apix-dashboard            # [OPTIONAL][MUST MATCH]
CHAT_JWT_AUDIENCE=apix-chatbot            # [OPTIONAL][MUST MATCH]
CHAT_JWT_TTL_MINUTES=30                   # [OPTIONAL] dashboard mints tokens with this TTL
CHAT_AUTH_DISABLED=false                  # [OPTIONAL] chatbot: true only for local dev without JWTs
CHAT_API_BASE_URL=                        # [REQUIRED for dashboard widget] browser-reachable chatbot URL
CHATBOT_API_URL=                          # [OPTIONAL] alias some code paths read
CHAT_REQUEST_TIMEOUT=30                   # [OPTIONAL]

# ── Frontend (React) build-time ──────────────────────────────────────────────
VITE_DASHBOARD_API_URL=                   # [REQUIRED for dashboard web] e.g. https://<api-host>/api
VITE_CHAT_API_URL=                        # [REQUIRED for dashboard web] browser chatbot URL (= CHAT_API_BASE_URL)
VITE_OPS_API_URL=                         # [REQUIRED for ops web] e.g. https://<ops-host>

# ── Guardrails: optional Azure Content Safety (off unless provisioned) ────────
AZURE_CONTENT_SAFETY_ENDPOINT=            # [OPTIONAL]
AZURE_CONTENT_SAFETY_API_KEY=             # [OPTIONAL]

# ── Observability: optional Azure Monitor (only when LLMOPS_TRACER=azure) ─────
APPLICATIONINSIGHTS_CONNECTION_STRING=    # [OPTIONAL]

# ── Programs / scope ─────────────────────────────────────────────────────────
DEFAULT_PROGRAM=telesales                 # [OPTIONAL]
TELESALES_PROGRAMS=                       # [OPTIONAL] comma-separated ProgramName values mapped to telesales
WCC_PROGRAMS=                             # [OPTIONAL]
PSO_PROGRAMS=                             # [OPTIONAL]
