# APIX Dashboard Environment Variables
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ============================================
# REQUIRED: Azure Blob Storage
# ============================================

# Connection string for Azure Storage Account
# Get from: Azure Portal > Storage Account > Access Keys > Connection String
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Container name where weekly reports are stored
AZURE_BLOB_CONTAINER=weekly-summary

# ============================================
# OPTIONAL: Default paths (auto-discovered if not set)
# ============================================

# Default index file path (format: index/YYYY-MM-DD.json)
# INDEX_BLOB_PATH=index/2025-08-28.json

# Default reports folder prefix (format: YYYY-MM-DD)
# REPORTS_PREFIX=2025-08-28

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Enable debug mode (shows additional logging)
# DEBUG=true

# ============================================
# OPTIONAL: Microsoft Entra ID Authentication
# ============================================

# Application (client) ID from Azure Portal > App registrations
# ENTRA_CLIENT_ID=your-client-id-here

# Client secret from Azure Portal > App registrations > Certificates & secrets
# ENTRA_CLIENT_SECRET=your-client-secret-here

# Directory (tenant) ID from Azure Portal > Microsoft Entra ID > Overview
# ENTRA_TENANT_ID=your-tenant-id-here

# Redirect URI registered in the app (must match exactly)
# ENTRA_REDIRECT_URI=http://localhost:8501

# ============================================
# REQUIRED: LLM / reasoning model (AI coaching)
# ============================================
# Single shared GPT-5.4 nano reasoning endpoint (same one used by the chatbot and
# the AI pipeline). Called through the Azure OpenAI v1 API (no api-version): the
# base URL is derived from the host of REASONING_MODEL_ENDPOINT as
# <host>/openai/v1/, unless you override it with REASONING_MODEL_BASE_URL.

# Azure OpenAI / Foundry endpoint
REASONING_MODEL_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Model deployment name
REASONING_MODEL_DEPLOYMENT=gpt-5.4-nano

# API key for the reasoning endpoint
REASONING_MODEL_APIKEY=your-reasoning-api-key-here

# Optional: override the derived v1 base URL
# REASONING_MODEL_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/

# ============================================
# REQUIRED: Chatbot API (floating chat widget)
# ============================================
# Base URL of the chatbot FastAPI service the widget calls from the browser.
CHAT_API_BASE_URL=http://localhost:8000

# Client-side abort budget in seconds.
CHAT_REQUEST_TIMEOUT=120

# Shared secret used to sign the short-lived JWT the chat widget sends to the
# chatbot API. MUST be identical to CHAT_JWT_SECRET in chatbot/.env. Generate a
# strong value: python -c "import secrets;print(secrets.token_urlsafe(48))"
CHAT_JWT_SECRET=CHANGE_ME_use_a_32plus_byte_random_secret_shared_with_chatbot
CHAT_JWT_ALG=HS256
CHAT_JWT_ISSUER=apix-app
CHAT_JWT_AUDIENCE=apix-chatbot
# Token lifetime in minutes (bounds how long a leaked token stays valid).
CHAT_JWT_TTL_MINUTES=30

# ============================================
# NOTES
# ============================================
# - Never share connection strings in chat/email
# - Rotate keys regularly
# - Use Key Vault references in production
# - Contact IT for production credentials
