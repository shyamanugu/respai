{
  "program_id": "wcc",
  "program_name": "BBV Voice,VZW BGCO Voice,VZMobile BGCO Loyalty,Social Media,VZ Mobile BGCO GEA,VZW BBT,VZ Mobile SLED",
  "blob_prefix": null,
  "cache_ttl_seconds": 900,
  "individual_metric_queries": {
    "rep_pivoted": "SELECT EmployeeID, MetricDesc, AVG(CAST(Result_Num AS FLOAT)) AS AvgValue, SUM(CAST(Result_Num AS FLOAT)) AS SumValue FROM vzw.rep_pivoted WHERE EmployeeID IN ({employee_ids}) AND Timeframe BETWEEN '{start_date}' AND '{end_date}' AND MetricDesc IS NOT NULL AND MetricDesc != '' AND MetricDesc IN ({metric_keys}) GROUP BY EmployeeID, MetricDesc",
    "customer_experience": "SELECT ID AS EmployeeID, 'VXS Overall Experience' AS MetricDesc, AVG(CAST([Contact Experience Score] AS FLOAT)) AS AvgValue, SUM(CAST([Contact Experience Score] AS FLOAT)) AS SumValue FROM ccs.customer_experience_score WHERE ID IN ({employee_ids}) AND StartDate BETWEEN '{start_date}' AND '{end_date}' AND [Contact Experience Score] IS NOT NULL GROUP BY ID",
    "rep_pivoted_team": "SELECT MIN(EmployeeID) AS EmployeeID, MetricDesc, AVG(CAST(Result_Num AS FLOAT)) AS AvgValue, SUM(CAST(Result_Num AS FLOAT)) AS SumValue FROM vzw.rep_pivoted WHERE VirtualLocationID = (SELECT TOP 1 VirtualLocationID FROM vzw.rep_pivoted WHERE EmployeeID IN ({employee_ids})) AND Timeframe BETWEEN '{start_date}' AND '{end_date}' AND MetricDesc IS NOT NULL AND MetricDesc != '' AND MetricDesc IN ({metric_keys}) GROUP BY MetricDesc",
    "customer_experience_team": "SELECT MIN(ID) AS EmployeeID, 'VXS Overall Experience' AS MetricDesc, AVG(CAST([Contact Experience Score] AS FLOAT)) AS AvgValue, SUM(CAST([Contact Experience Score] AS FLOAT)) AS SumValue FROM ccs.customer_experience_score WHERE [Manager 1] = (SELECT TOP 1 [Manager 1] FROM ccs.customer_experience_score WHERE ID IN ({employee_ids})) AND StartDate BETWEEN '{start_date}' AND '{end_date}' AND [Contact Experience Score] IS NOT NULL"
  },
