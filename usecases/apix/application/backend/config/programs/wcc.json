  "risk_rules": [
    {
      "type": "delta_decline",
      "threshold": -3,
      "severity": "high",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "delta_decline",
      "threshold": -5,
      "severity": "critical",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "low_score",
