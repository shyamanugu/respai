        "vxs_solutions"
      ],
      "threshold": 70,
      "severity": "high",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "low_score",
      "kpis": [
        "vxs",
        "vxs_solutions"
      ],
      "threshold": 60,
      "severity": "critical",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "high_value",
      "kpis": [
        "escalations"
      ],
      "threshold": 2,
      "severity": "high",
      "reason": "Elevated escalation count: {value} incidents"
    },
    {
      "type": "high_value",
      "kpis": [
        "escalations"
      ],
      "threshold": 5,
      "severity": "critical",
      "reason": "Elevated escalation count: {value} incidents"
    },
    {
      "type": "below_target",
      "kpis": [
        "new_line_pitches"
      ],
      "threshold": 30,
      "severity": "high",
      "reason": "Below target: {value} (target: 40+)"
    },
    {
      "type": "below_target",
      "kpis": [
        "mobile_protection"
      ],
      "threshold": 20,
      "severity": "high",
      "reason": "Below target: {value} (target: 30+)"
    }
  ],
