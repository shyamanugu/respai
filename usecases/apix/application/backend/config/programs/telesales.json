{
  "program_id": "telesales",
  "program_name": "VZW Telesales",
  "cache_ttl_seconds": 900,
  "blob_prefix": null,
  "individual_metric_queries": {
    "rep_pivoted": "SELECT EmployeeID, MetricDesc, AVG(CAST(Result_Num AS FLOAT)) AS AvgValue, SUM(CAST(Result_Num AS FLOAT)) AS SumValue FROM vzw.rep_pivoted WHERE EmployeeID IN ({employee_ids}) AND Timeframe BETWEEN '{start_date}' AND '{end_date}' AND MetricDesc IS NOT NULL AND MetricDesc != '' AND MetricDesc IN ({metric_keys}) GROUP BY EmployeeID, MetricDesc",
    "customer_experience": "SELECT ID AS EmployeeID, 'VXS Overall Experience' AS MetricDesc, AVG(CAST([Contact Experience Score] AS FLOAT)) AS AvgValue, SUM(CAST([Contact Experience Score] AS FLOAT)) AS SumValue FROM ccs.customer_experience_score WHERE ID IN ({employee_ids}) AND StartDate BETWEEN '{start_date}' AND '{end_date}' AND [Contact Experience Score] IS NOT NULL GROUP BY ID",
    "order_lookup_tool": "SELECT x.EmployeeID, v.MetricDesc, AVG(v.val) AS AvgValue, SUM(v.val) AS SumValue FROM (SELECT EID AS EmployeeID, CAST([Quantity] AS FLOAT) AS units, 1.0 AS order_lines, CASE WHEN [Return Days] IS NOT NULL AND [Return Days] > 0 THEN 1.0 ELSE 0.0 END AS returns_flag, CASE WHEN [Install Date] IS NOT NULL THEN 1.0 ELSE 0.0 END AS install_flag, CASE WHEN [Comp Flag] IN ('Y','Yes','y','yes','1','True','true') THEN 1.0 ELSE 0.0 END AS comp_flag FROM vzw.order_lookup_tool WHERE EID IN ({employee_ids}) AND BizDate BETWEEN '{start_date}' AND '{end_date}') x CROSS APPLY (VALUES ('Units Sold', x.units), ('Order Lines', x.order_lines), ('Returns', x.returns_flag), ('Installs', x.install_flag), ('Comps', x.comp_flag)) v(MetricDesc, val) GROUP BY x.EmployeeID, v.MetricDesc",
    "solutions": "SELECT x.EmployeeID, v.MetricDesc, AVG(v.val) AS AvgValue, SUM(v.val) AS SumValue FROM (SELECT EmployeeID, CAST(Transfer_Flag AS FLOAT) AS transfers, CAST(AppEng_Num AS FLOAT) AS app_eng, CAST(VT_ATTACH_NUM AS FLOAT) AS cobrowse, CAST(Trg_Call_Cnt AS FLOAT) AS tech_esc, CAST(Occ_Trans_Cnt AS FLOAT) AS value_trans FROM vzw.solutions WHERE EmployeeID IN ({employee_ids}) AND ReportDate BETWEEN '{start_date}' AND '{end_date}') x CROSS APPLY (VALUES ('Transfers', x.transfers), ('App Engagements', x.app_eng), ('Co-Browse Attaches', x.cobrowse), ('Tech Escalations', x.tech_esc), ('Value Transactions', x.value_trans)) v(MetricDesc, val) GROUP BY x.EmployeeID, v.MetricDesc"
  },
  "individual_metrics": {
    "groups": [
      {
        "name": "Resolve",
        "kpis": [
          { "column_key": "2-Hour Resolve", "label": "2-Hour Resolve", "query": "rep_pivoted" },
