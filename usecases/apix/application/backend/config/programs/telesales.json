          { "column_key": "Units Sold", "label": "Units Sold", "query": "order_lookup_tool" },
          { "column_key": "Order Lines", "label": "Orders", "query": "order_lookup_tool" },
          { "column_key": "Returns", "label": "Returns", "query": "order_lookup_tool" },
          { "column_key": "Installs", "label": "Installs", "query": "order_lookup_tool" },
          { "column_key": "Comps", "label": "Comps", "query": "order_lookup_tool" }
        ]
      },
      {
        "name": "Behaviours",
        "kpis": [
          { "column_key": "Transfers", "label": "Transfers", "query": "solutions" },
          { "column_key": "App Engagements", "label": "App Engagements", "query": "solutions" },
          { "column_key": "Co-Browse Attaches", "label": "Co-Browse Attaches", "query": "solutions" },
          { "column_key": "Tech Escalations", "label": "Tech Escalations", "query": "solutions" },
          { "column_key": "Value Transactions", "label": "Value Transactions", "query": "solutions" }
        ]
      }
    ]
  },
  "inverse_kpis": [
    "escalations",
    "new_line_opportunity_missed",
    "upgrade_opportunity_missed"
  ],
  "scoring": [
    {
      "type": "quality",
      "weight": 0.4,
      "kpis": [
        { "key": "customer_experience", "source": "kpis", "pre_scaled": false }
      ]
    },
    {
      "type": "target",
      "weight": 0.3,
      "targets": [
        { "key": "new_line_pitches", "target": 40, "source": "kpis" },
        { "key": "mobile_protection", "target": 30, "source": "kpis" },
        { "key": "save_attempts", "target": 10, "source": "kpis" }
      ]
    },
    {
      "type": "trend",
      "weight": 0.2,
      "source": "kpis",
      "metrics_ref": "individual_page.trends.trend_metrics"
    },
    {
      "type": "penalty",
      "weight": 0.1,
      "kpis": [
        { "key": "escalations", "source": "kpis" }
      ],
      "tiers": [
        {
          "max": 0,
          "penalty": 0
        },
        {
          "max": 2,
          "per_unit": 10
        },
        {
          "max": 5,
          "base": 20,
          "per_unit": 15
        },
        {
          "max": null,
          "base": 65,
          "per_unit": 10
        }
      ]
    }
  ],
  "risk_rules": [
    {
      "type": "delta_decline",
      "threshold": -3,
      "severity": "high",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "delta_decline",
      "threshold": -5,
      "severity": "critical",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "low_score",
      "kpis": [
        "vxs",
        "vxs_solutions"
      ],
      "threshold": 70,
      "severity": "high",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "low_score",
      "kpis": [
        "vxs",
        "vxs_solutions"
      ],
      "threshold": 60,
      "severity": "critical",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "high_value",
      "kpis": [
        "escalations"
      ],
      "threshold": 2,
      "severity": "high",
      "reason": "Elevated escalation count: {value} incidents"
    },
    {
      "type": "high_value",
      "kpis": [
        "escalations"
      ],
      "threshold": 5,
      "severity": "critical",
      "reason": "Elevated escalation count: {value} incidents"
    },
    {
      "type": "below_target",
      "kpis": [
        "new_line_pitches"
      ],
      "threshold": 30,
      "severity": "high",
      "reason": "Below target: {value} (target: 40+)"
    },
    {
      "type": "below_target",
      "kpis": [
        "mobile_protection"
      ],
      "threshold": 20,
      "severity": "high",
      "reason": "Below target: {value} (target: 30+)"
    }
  ],
