    {
      "type": "quality",
      "weight": 0.4,
      "kpis": [
        { "key": "customer_experience", "source": "kpis", "pre_scaled": false }
      ]
    },
    {
      "type": "target",
      "weight": 0.3,
      "targets": [
        { "key": "fcr_likelihood", "target": 0.7, "source": "kpis" },
        { "key": "quality", "target": 0.7, "source": "kpis" },
        { "key": "issue_resolution_effectiveness", "target": 0.7, "source": "kpis" }
      ]
    },
    {
      "type": "trend",
      "weight": 0.2,
      "source": "kpis",
      "metrics_ref": "individual_page.trends.trend_metrics"
    },
    {
      "type": "penalty",
      "weight": 0.1,
      "kpis": [
        { "key": "escalations", "source": "kpis" }
      ],
      "tiers": [
        { "max": 0, "penalty": 0 },
        { "max": 2, "per_unit": 10 },
        { "max": 5, "base": 20, "per_unit": 15 },
        { "max": null, "base": 65, "per_unit": 10 }
      ]
    }
  ],
  "risk_rules": [
    {
      "type": "delta_decline",
      "threshold": -3,
      "severity": "high",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "delta_decline",
      "threshold": -5,
      "severity": "critical",
      "reason": "Declining trend: {delta} from previous period"
    },
    {
      "type": "low_score",
      "kpis": ["customer_experience", "predicted_csat"],
      "threshold": 70,
      "severity": "high",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "low_score",
      "kpis": ["customer_experience", "predicted_csat"],
      "threshold": 60,
      "severity": "critical",
      "reason": "Quality score below target: {value}/100"
    },
    {
      "type": "high_value",
      "kpis": ["escalations"],
      "threshold": 2,
      "severity": "high",
      "reason": "Elevated escalation count: {value} incidents"
    },
    {
      "type": "high_value",
      "kpis": ["escalations"],
      "threshold": 5,
