{
  "program_id": "pso",
  "program_name": "VZ Mobile Service",
  "blob_prefix": null,
  "cache_ttl_seconds": 900,
  "individual_metric_queries": {
    "rep_pivoted": "SELECT EmployeeID, MetricDesc, AVG(CAST(Result_Num AS FLOAT)) AS AvgValue, SUM(CAST(Result_Num AS FLOAT)) AS SumValue FROM vzw.rep_pivoted WHERE EmployeeID IN ({employee_ids}) AND Timeframe BETWEEN '{start_date}' AND '{end_date}' AND MetricDesc IS NOT NULL AND MetricDesc != '' AND MetricDesc IN ({metric_keys}) GROUP BY EmployeeID, MetricDesc",
    "customer_experience": "SELECT ID AS EmployeeID, 'VXS Overall Experience' AS MetricDesc, AVG(CAST([Contact Experience Score] AS FLOAT)) AS AvgValue, SUM(CAST([Contact Experience Score] AS FLOAT)) AS SumValue FROM ccs.customer_experience_score WHERE ID IN ({employee_ids}) AND StartDate BETWEEN '{start_date}' AND '{end_date}' AND [Contact Experience Score] IS NOT NULL GROUP BY ID",
    "solutions": "SELECT u.EmployeeID, u.MetricDesc, u.Val AS AvgValue, u.Val AS SumValue FROM (SELECT EmployeeID, CAST(100.0*SUM(VXS_Overall_Rep_Pass)/NULLIF(SUM(VXS_Overall_Rep_Cnt),0) AS FLOAT) AS CSAT, CAST(100.0*SUM(VXS_VZ_Sat_Pass)/NULLIF(SUM(VXS_VZ_Sat_Cnt),0) AS FLOAT) AS VZSat, CAST(100.0*SUM(Transfer_Flag)/NULLIF(SUM(CallsAnswered),0) AS FLOAT) AS TransferRate, CAST(SUM(Handle_Tm_Seconds)/NULLIF(SUM(CallsAnswered),0) AS FLOAT) AS AHT, CAST(100.0*SUM(Resolve_2Hr_Count)/NULLIF(SUM(Resolve_Total_Contacts),0) AS FLOAT) AS Resolve2Hr, CAST(100.0*SUM(Resolve_Same_Day_Count)/NULLIF(SUM(Resolve_Total_Contacts),0) AS FLOAT) AS ResolveSameDay, CAST(100.0*SUM(Resolve_3Day_Count)/NULLIF(SUM(Resolve_Total_Contacts),0) AS FLOAT) AS Resolve3Day, CAST(100.0*SUM(Resolve_7Day_Count)/NULLIF(SUM(Resolve_Total_Contacts),0) AS FLOAT) AS Resolve7Day, CAST(100.0*SUM(Resolve_5Day_Count)/NULLIF(SUM(Resolve_Total_Contacts),0) AS FLOAT) AS Resolve5Day, CAST(SUM(CallsAnswered) AS FLOAT) AS CallsAns, CAST(SUM(AppEng_Num) AS FLOAT) AS AppEng, CAST(100.0*SUM(VT_ATTACH_NUM)/NULLIF(SUM(VT_Eligible_Count),0) AS FLOAT) AS VTAttach, CAST(SUM(VPC_Num)/NULLIF(SUM(CallsAnswered),0) AS FLOAT) AS VPC, CAST(SUM(OCC_Amt)/NULLIF(SUM(Occ_Trans_Cnt),0) AS FLOAT) AS OCCContact, CAST(SUM(NVPH_Num) AS FLOAT) AS VPH, CAST(SUM(Resolve_Total_Contacts) AS FLOAT) AS TotalContacts FROM vzw.solutions WHERE EmployeeID IN ({employee_ids}) AND ReportDate BETWEEN '{start_date}' AND '{end_date}' GROUP BY EmployeeID) s UNPIVOT (Val FOR MetricDesc IN (CSAT, VZSat, TransferRate, AHT, Resolve2Hr, ResolveSameDay, Resolve3Day, Resolve7Day, Resolve5Day, CallsAns, AppEng, VTAttach, VPC, OCCContact, VPH, TotalContacts)) u"
  },
  "individual_metrics": {
    "groups": [
      {
        "name": "Customer Satisfaction",
        "kpis": [
          { "column_key": "CSAT", "label": "Customer Satisfaction", "query": "solutions", "is_percentage": true, "higher_is_better": true },
