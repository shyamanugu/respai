          { "column_key": "TransferRate", "label": "Transfer Rate", "query": "solutions", "is_percentage": true, "higher_is_better": false },
          { "column_key": "AHT", "label": "Avg Handle Time", "query": "solutions", "unit_divisor": 60, "unit_suffix": " min", "higher_is_better": false }
        ]
      },
