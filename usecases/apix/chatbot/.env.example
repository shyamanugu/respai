# APIX Chatbot — environment variables
# Copy this file to .env and fill in the values. DO NOT commit .env.

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SQLite (local KPI / JSON data source) ────────────────────────────────
CHAT_AGENT_DB_PATH=chatbot/data/employee_analytics.db

# ── Azure SQL Database (vzw.rep_pivoted performance metrics) ──────────────
# Auth is via Azure AD token (DefaultAzureCredential): `az login` locally, or a
# Managed Identity in Azure. No username/password is stored.
AZURE_SQL_SERVER=your-sql-server.database.windows.net
AZURE_SQL_DATABASE=your-database
AZURE_SQL_PORT=1433
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
REP_TABLE=vzw.rep_pivoted

# Data-source mode: auto | sqlite | azure | both
SOURCE_MODE=auto

# ── Azure OpenAI — reasoning model (narration / routing) ─────────────────
REASONING_MODEL_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
REASONING_MODEL_DEPLOYMENT=gpt-5.4-nano
REASONING_MODEL_APIKEY=your-reasoning-api-key-here
# REASONING_MODEL_BASE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/

# ── API authentication ───────────────────────────────────────────────────
# The chatbot API is called directly from the browser by the Streamlit app's
# chat widget. The app mints a short-lived JWT per logged-in user; the chatbot
# validates it here. CHAT_JWT_SECRET MUST be identical to application/.env.
# Generate a strong value: python -c "import secrets;print(secrets.token_urlsafe(48))"
CHAT_JWT_SECRET=CHANGE_ME_use_a_32plus_byte_random_secret_shared_with_chatbot
CHAT_JWT_ALG=HS256
CHAT_JWT_ISSUER=apix-app
CHAT_JWT_AUDIENCE=apix-chatbot
# Local development only — set to true to bypass API authentication entirely.
CHAT_AUTH_DISABLED=false
